<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="'$(MedicalInfoFramework)' != ''">$(MedicalInfoFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IdentityVersion>10.0.13</IdentityVersion>
    <IdentityVersion Condition="'$(MedicalInfoFramework)' == 'net9.0'">9.0.21</IdentityVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="$(IdentityVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(IdentityVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="$(IdentityVersion)" PrivateAssets="all" />
  </ItemGroup>
</Project>
