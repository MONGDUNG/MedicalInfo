# Docker Desktop: Elasticsearch running on the host computer.
# Linux/server: replace with a reachable Elasticsearch service hostname.
ELASTICSEARCH_URL=http://host.docker.internal:9200
ELASTICSEARCH_INDEX=item
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_TIMEOUT_SECONDS=5
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
ALLOWED_HOSTS=localhost;127.0.0.1
# Account mail: SMTP with STARTTLS (usually port 587), fixed public HTTPS origin.
MAIL_MODE=Disabled
MAIL_PUBLIC_URL=
MAIL_FROM=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_REQUIRE_CONFIRMED_EMAIL=false
# Social callbacks: /signin-kakao and /signin-naver on this fixed HTTPS origin.
SOCIAL_PUBLIC_URL=
SOCIAL_KAKAO_ENABLED=false
SOCIAL_KAKAO_CLIENT_ID=
SOCIAL_KAKAO_CLIENT_SECRET=
SOCIAL_NAVER_ENABLED=false
SOCIAL_NAVER_CLIENT_ID=
SOCIAL_NAVER_CLIENT_SECRET=
