# Docker Desktop: Elasticsearch running on the host computer.
# Linux/server: replace with a reachable Elasticsearch service hostname.
ELASTICSEARCH_URL=http://host.docker.internal:9200
ELASTICSEARCH_INDEX=item
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_TIMEOUT_SECONDS=5
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
ALLOWED_HOSTS=localhost;127.0.0.1
